# Copy to .env for local "production-like" runs. Never commit .env.
# In production these come from the WSGI file on PythonAnywhere.

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# false in production. true locally.
DJANGO_DEBUG=true

# Comma separated. No scheme, no trailing slash.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated, WITH scheme. Required for POST forms behind the host's proxy.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
